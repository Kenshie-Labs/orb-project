---
import { getCollection } from "astro:content";
import "../../styles/global.css";
import Navbar from "../../components/Navbar.svelte";
import ThemeInit from "../../components/ThemeInit.astro";
import { ClientRouter } from "astro:transitions";

const allEntries = await getCollection("content");

const categories = [
  ...new Set(allEntries.map((entry) => entry.id.split("/")[0])),
].sort();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="viewport" content="width=device-width" />
    <title>Archive — Orb</title>
    <ThemeInit />
    <ClientRouter />
  </head>
  <body class="min-h-screen">

    <Navbar client:idle transition:persist="navbar" />

    <main class="max-w-5xl mx-auto px-7 py-14">

      <h1 class="text-center text-5xl text-orb-dark dark:text-orb-tan m-10">
        archive of our knowledge
      </h1>

      <div class="flex flex-wrap justify-center gap-3">
        {categories.map((cat) => (
          <a
            href={`/notes/${cat}`}
            data-astro-prefetch
            class="px-6 py-3 border border-orb-dark dark:border-orb-tan
                   rounded-lg capitalize
                   text-orb-dark dark:text-orb-tan
                   hover:shadow-brutal dark:hover:shadow-brutal-onDarkMode
                   active:shadow-brutal dark:active:shadow-brutal-onDarkMode
                   transition-shadow duration-150 hover:bg-orange-400 active:bg-orange-400"
          >
            {cat}
          </a>
        ))}
      </div>

    </main>
  </body>
</html>
