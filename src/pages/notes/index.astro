---
import { getCollection } from "astro:content";
import "../../styles/global.css";

const allEntries = await getCollection("content");

// Ambil nama folder root saja, lalu deduplikasi
const categories = [...new Set(
  allEntries.map((entry) => entry.id.split("/")[0])
)].sort();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Archive — Orb</title>
  </head>
  <body class="min-h-screen">

    <!-- Navigation Panel -->
    <header class="sticky top-0 z-50 border-b-2 border-orb-dark bg-orb-tan">
      <div class="max-w-screen-xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-petrona font-bold text-lg tracking-wide">
          <img src="/favicon.svg" alt="Orb logo" class="w-7 h-7" />
          ORB Knownrie
        </a>
        <nav class="flex gap-6 text-sm">
          <a href="/notes" class="hover:underline">Notes</a>
          <a href="/" class="hover:underline">About</a>
        </nav>
      </div>
    </header>
    
    <main class="max-w-5xl mx-auto px-7 py-14">

      <h1 class="text-center text-5xl text-orb-dark m-10">
        archive of our knowledge
      </h1>

      <div class="flex flex-wrap justify-center gap-3">
        {categories.map((cat) => (
          <a
            href={`/notes/${cat}`}
            class="px-6 py-3 border border-orb-dark rounded-lg capitalize text-orb-dark hover:shadow-brutal transition-shadow duration-150 hover:bg-orange-400"
          >
            {cat}
          </a>
        ))}
      </div>

    </main>
  </body>
</html>
