---
import CurrencyMarquee from '../components/currencyMarquee.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Landing Page">

    <p class="text-center">Quick comparison of currency values to the 1 dollar</p>
    <CurrencyMarquee client:only="svelte" />

        <main class="max-w-4xl mx-auto px-6 py-16">
          <!-- HERO -->
          <section class="text-center py-12 border-b-2 border-orb-dark dark:border-orb-tan mb-16">
            <h1 class="text-5xl mb-6 font-bold tracking-tighter">Observatory of Research & Brainstorming.</h1>
            <p class="text-xl max-w-2xl mx-auto font-source-sans font-light mb-10">
              Knownledge repository in eternity. <br>
              A place where I store my idea explorations, technical notes, and structured thoughts.
              A digital space for continuous learning and growth.
            </p>
            <div class="flex gap-4 justify-center">
              <a href="/notes" class="px-8 py-3 bg-orange-400 text-orb-tan dark:bg-orb-tan dark:text-orb-dark font-bold border-2 border-orb-dark shadow-brutal dark:shadow-brutal-onDarkMode hover:-translate-y-1 active:-translate-y-1 transition-transform">
                Browse All Notes
              </a>
            </div>
          </section>

          <!-- FEATURES / CATEGORIES -->
          <section class="grid md:grid-cols-2 gap-8 mb-20">
            <div class="p-6 border-2 border-orb-dark shadow-brutal dark:shadow-brutal-onDarkMode bg-white dark:bg-orb-dark/50">
              <h2 class="text-2xl font-bold mb-3">Technical Deep-dives</h2>
              <p class="font-source-sans text-sm opacity-80">An in-depth exploration of software technologies, frameworks, and architectures.</p>
            </div>
            <div class="p-6 border-2 border-orb-dark shadow-brutal dark:shadow-brutal-onDarkMode bg-white dark:bg-orb-dark">
              <h2 class="text-2xl font-bold mb-3">Brainstorming Lab</h2>
              <p class="font-source-sans text-sm opacity-80">Raw notes, experimental ideas, and ongoing thought processes.</p>
            </div>
          </section>
        </main>

        <footer class="text-center py-10 border-t-2 border-orb-dark/20 text-sm">
          <p class="font-source-sans">© {new Date().getFullYear()} Orb Knownrie — Built by <a href="https://axelkenshi.my.id" class="text-blue-400">Axel</a></p>
        </footer>
</BaseLayout>
