---
import { getCollection, type CollectionEntry } from "astro:content";
import "../styles/global.css";
import Navbar from "../components/Navbar.svelte";
import DocsPagination from "../components/DocsPagination.svelte";
import DocsSidebarNav from "./DocsSidebarNav.astro";
import TranslateToggle from "../components/TranslateToggle.astro"
import ThemeInit from "../components/ThemeInit.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  category: string;
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
  excerpt?: string;
}

const { title, category, currentId, headings = [], excerpt } = Astro.props;

// Heading yang dipakai di TOC (depth <= 3)
const tocHeadings = headings.filter((h) => h.depth <= 3);

// Fetch sidebar entries for this category
const allEntries = await getCollection("content");
const categoryEntries = allEntries
  .filter((e) => e.id.split("/")[0] === category)
  .sort((a, b) => a.id.localeCompare(b.id));

// Group by subcategory (parts[1] if depth >= 3, else "_root")
const grouped: Record<string, CollectionEntry<"content">[]> = {};
for (const entry of categoryEntries) {
  const parts = entry.id.split("/");
  const subcat = parts.length >= 3 ? parts[1] : "_root";
  if (!grouped[subcat]) grouped[subcat] = [];
  grouped[subcat].push(entry);
}

// Build intermediate breadcrumb segments from currentId
// e.g. "academics/informatika/pengantar" → subcatParts = ["informatika"]
let breadcrumbMiddle: { label: string; href: string }[] = [];
if (currentId) {
  const parts = currentId.split("/");
  const subcatParts = parts.slice(1, -1);
  breadcrumbMiddle = subcatParts.map((seg, i) => ({
    label: seg.replace(/-/g, " "),
    href: `/notes/${[parts[0], ...subcatParts.slice(0, i + 1)].join("/")}`,
  }));
}

// Determine previous and next pages for pagination
let currentPage = null;
let prevPage = null;
let nextPage = null;

if (currentId) {
  const currentIndex = categoryEntries.findIndex((entry) => entry.id === currentId);
  if (currentIndex !== -1) {
    const currentEntry = categoryEntries[currentIndex];
    currentPage = {
      title: currentEntry.data.title,
      url: `/notes/${currentEntry.id}`,
    };

    if (currentIndex > 0) {
      const prevEntry = categoryEntries[currentIndex - 1];
      prevPage = {
        title: prevEntry.data.title,
        url: `/notes/${prevEntry.id}`,
      };
    }

    if (currentIndex < categoryEntries.length - 1) {
      const nextEntry = categoryEntries[currentIndex + 1];
      nextPage = {
        title: nextEntry.data.title,
        url: `/notes/${nextEntry.id}`,
      };
    }
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Orb</title>
    <!-- pwa -->
    <script src="../pwa.ts"></script>
    <!-- FOUC prevention: apply dark class sebelum paint -->
    <ThemeInit />
    <!-- Client-side navigation antar halaman (eliminasi full page reload) -->
    <ClientRouter />
  </head>
  <body class="min-h-screen">

    <!-- Navbar: persisted across navigations agar tidak re-hydrate setiap pindah halaman -->
    <Navbar client:idle transition:persist="navbar" />

    <!-- 3-column docs body -->
    <!-- id "note-content" Area yang diterjemahkan: judul, deskripsi, gambar, dan isi markdown -->
    <div id="note-content" class="max-w-screen-xl mx-auto flex min-h-[calc(100vh-3.5rem)]">

      <!-- LEFT SIDEBAR (desktop only, lg+) -->
      <aside class="hidden lg:flex flex-col w-64 shrink-0 border-r-2
                    border-orb-dark dark:border-orb-tan
                    sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto hide-scrollbar">
        <div class="p-5">

          <!-- Back link -->
          <a
            href="/notes"
            class="flex items-center gap-1 text-xs mb-5 uppercase tracking-widest
                   text-orb-dark/50 hover:text-orb-dark active:text-orb-dark
                   dark:text-orb-tan/50 dark:hover:text-orb-tan dark:active:text-orb-tan"
          >
            ← All Notes
          </a>

          <p class="text-xs font-bold uppercase tracking-widest mb-3
                    text-orb-dark/40 dark:text-orb-tan/40">
            Browse {category.replace(/-/g, " ")}
          </p>

          <DocsSidebarNav category={category} grouped={grouped} currentId={currentId} />
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="flex-1 min-w-0 mx-auto w-full max-w-3xl
                   px-4 sm:px-6 md:px-8 lg:px-10
                   py-6 md:py-10">

        <!-- Breadcrumb -->
        <nav class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs sm:text-sm mb-5 md:mb-6
                    text-orb-dark/50 dark:text-orb-tan/50">
          <a href="/" class="hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">Home</a>
          <span>/</span>
          <a href="/notes" class="hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">Notes</a>
          <span>/</span>
          <a href={`/notes/${category}`}
             class="capitalize hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">
            {category.replace(/-/g, " ")}
          </a>
          {breadcrumbMiddle.map((seg) => (
            <>
              <span>/</span>
              <a href={seg.href} class="capitalize hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">
                {seg.label}
              </a>
            </>
          ))}
          {currentId && (
            <>
              <span>/</span>
              <span class="font-medium text-orb-dark dark:text-orb-tan break-words">{title}</span>
            </>
          )}
        </nav>

        <!-- Category chip -->
        <div class="flex">
          <span class="inline-block px-3 py-1 text-xs font-bold uppercase mb-4 md:mb-5 tracking-widest
                       border-2 border-orb-dark bg-orange-400 dark:border-orb-tan">
            {category.replace(/-/g, " ")}
            
          </span>
          <TranslateToggle />
        </div>
        
        <!-- Page title -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-petrona font-light leading-tight mb-3 break-words
                   text-orb-dark dark:text-orb-tan">
          {title}
        </h1>

        {excerpt && (
          <p class="text-base md:text-lg mb-2 font-light text-orb-dark/60 dark:text-orb-tan/60">
            {excerpt}
          </p>
        )}

        <!-- Browse sidebar (tablet & mobile, di bawah lg) -->
        <details class="lg:hidden mt-6 mb-6 border-2 border-orb-dark dark:border-orb-tan shadow-brutal dark:shadow-brutal-onDarkMode bg-white dark:bg-orb-dark/50">
          <summary class="p-4 cursor-pointer font-bold uppercase tracking-widest text-sm flex items-center gap-2 select-none">
            <span class="w-2 h-2 bg-orange-400 shrink-0"></span>
            Browse {category.replace(/-/g, " ")}
          </summary>
          <nav class="p-4 border-t-2 border-orb-dark dark:border-orb-tan">
            <a href="/notes" class="block text-xs mb-4 uppercase tracking-widest
                                   text-orb-dark/50 hover:text-orb-dark active:text-orb-dark
                                   dark:text-orb-tan/50 dark:hover:text-orb-tan dark:active:text-orb-tan">
              ← All Notes
            </a>
            <DocsSidebarNav category={category} grouped={grouped} currentId={currentId} />
          </nav>
        </details>

        <!-- TOC Mobile (di bawah xl) -->
        {tocHeadings.length > 0 && (
          <details class="xl:hidden mb-8 border-2 border-orb-dark dark:border-orb-tan shadow-brutal dark:shadow-brutal-onDarkMode bg-white dark:bg-orb-dark/50">
            <summary class="p-4 cursor-pointer font-bold uppercase tracking-widest text-sm flex items-center gap-2 select-none">
              <span class="w-2 h-2 bg-green-400 shrink-0"></span>
              In This Guide
            </summary>
            <nav class="p-4 border-t-2 border-orb-dark dark:border-orb-tan space-y-1">
              {tocHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  data-toc-link
                  data-slug={h.slug}
                  class={[
                    "toc-link block transition-colors py-1 border-l-2 border-transparent",
                    "text-orb-dark/55 hover:text-orange-500 active:text-orange-500 dark:text-orb-tan/55 font-source-sans",
                    h.depth === 2 ? "pl-2 text-sm font-bold" : "pl-5 text-xs",
                  ].join(" ")}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <!-- Markdown content -->
        <div class="prose prose-neutral prose-brutal dark:prose-dark max-w-none
                    [&_table]:block [&_table]:overflow-x-auto [&_table]:max-w-full
                    mt-6 md:mt-8 pt-6 md:pt-8 border-t-2 border-orb-dark/20 dark:border-orb-tan/20">
          <slot />
        </div>

        <!-- ===== Dock aksesibilitas: hanya mobile & tablet ===== -->
        <div class="dock lg:hidden" data-dock>
          <button type="button" class="dock-btn" data-open="pages" aria-label="Daftar halaman" aria-haspopup="dialog">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </button>
          <button type="button" class="dock-btn" data-open="toc" aria-label="Daftar isi" aria-haspopup="dialog">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 5H3"/><path d="M16 12H3"/><path d="M16 19H3"/><path d="M21 5h.01"/><path d="M21 12h.01"/><path d="M21 19h.01"/></svg>
          </button>
          <button type="button" class="dock-btn" data-open="a11y" aria-label="Aksesibilitas" aria-haspopup="dialog">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="16" cy="4" r="1"/><path d="m18 19 1-7-6 1"/><path d="m5 8 3-3 5.5 3-2.36 3.5"/><path d="M4.24 14.5a5 5 0 0 0 6.88 6"/><path d="M13.76 17.5a5 5 0 0 0-6.88-6"/></svg>
          </button>
        </div>
        
        <!-- Popup daftar halaman -->
        <dialog class="dock-dialog" data-dialog="pages" aria-label="Daftar halaman">
          <div class="dock-dialog-head">
            <span>Browse {category.replace(/-/g, " ")}</span>
            <button type="button" class="dock-close" data-close aria-label="Tutup">✕</button>
          </div>
          <nav class="dock-dialog-body">
            <a href="/notes" class="dock-link">← All Notes</a>
            <DocsSidebarNav category={category} grouped={grouped} currentId={currentId} />
          </nav>
        </dialog>
        
        <!-- Popup daftar isi -->
        <dialog class="dock-dialog" data-dialog="toc" aria-label="Daftar isi">
          <div class="dock-dialog-head">
            <span>In This Guide (Headings)</span>
            <button type="button" class="dock-close" data-close aria-label="Tutup">✕</button>
          </div>
          <nav class="dock-dialog-body">
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                data-toc-link
                data-slug={h.slug}
                data-close-on-click
                class={["dock-link toc-link", h.depth === 2 ? "pl-2 font-bold" : "pl-5 text-xs"].join(" ")}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </dialog>

        <!-- Popup aksesibilitas -->
        <dialog class="dock-dialog" data-dialog="a11y" aria-label="Aksesibilitas">
          <div class="dock-dialog-head">
            <span>Aksesibilitas</span>
            <button type="button" class="dock-close" data-close aria-label="Tutup">✕</button>
          </div>
        
          <div class="dock-dialog-body a11y-body">
        
            <!-- Ukuran teks -->
            <section class="a11y-group">
              <h3 class="a11y-title">Ukuran teks</h3>
              <div class="a11y-segment" role="radiogroup" aria-label="Ukuran teks">
                <button type="button" role="radio" data-a11y="textSize" data-value="normal" aria-checked="true"><span class="text-sm">a</span></button>
                <button type="button" role="radio" data-a11y="textSize" data-value="large" aria-checked="false"><span class="text-lg font-bold">A</span></button>
              </div>
            </section>
        
            <!-- Jarak teks -->
            <section class="a11y-group">
              <h3 class="a11y-title">Jarak huruf dan baris</h3>
              <div class="a11y-segment" role="radiogroup" aria-label="Jarak teks">
                <button type="button" role="radio" data-a11y="spacing" data-value="normal" aria-checked="true">Normal</button>
                <button type="button" role="radio" data-a11y="spacing" data-value="wide" aria-checked="false">Lebar</button>
              </div>
            </section>
        
            <!-- Kontras -->
            <section class="a11y-group">
              <h3 class="a11y-title">Kontras</h3>
              <div class="a11y-segment" role="radiogroup" aria-label="Kontras">
                <button type="button" role="radio" data-a11y="contrast" data-value="normal" aria-checked="true">Normal</button>
                <button type="button" role="radio" data-a11y="contrast" data-value="high" aria-checked="false">Tinggi</button>
              </div>
            </section>
        
            <!-- Filter warna -->
            <section class="a11y-group">
              <h3 class="a11y-title">Filter warna <span class="a11y-badge">Eksperimental</span></h3>
              <p class="a11y-note">Membantu sebagian pengguna, belum tentu cocok untuk semua jenis buta warna.</p>
              <div class="a11y-segment" role="radiogroup" aria-label="Filter warna">
                <button type="button" role="radio" data-a11y="colorFilter" data-value="none" aria-checked="true">Normal</button>
                <button type="button" role="radio" data-a11y="colorFilter" data-value="protanopia" aria-checked="false">Protan</button>
                <button type="button" role="radio" data-a11y="colorFilter" data-value="deuteranopia" aria-checked="false">Deutan</button>
                <button type="button" role="radio" data-a11y="colorFilter" data-value="tritanopia" aria-checked="false">Tritan</button>
              </div>
            </section>
        
            <!-- Tampilan -->
            <section class="a11y-group">
              <h3 class="a11y-title">Tampilan</h3>
              <label class="a11y-toggle">
                <input type="checkbox" data-a11y="monochrome" />
                <span>Hitam putih</span>
              </label>
              <label class="a11y-toggle">
                <input type="checkbox" data-a11y="dyslexic" />
                <span>Font ramah disleksia</span>
              </label>
              <label class="a11y-toggle">
                <input type="checkbox" data-a11y="readFocus" />
                <span>Mode fokus membaca</span> <br/>
                <span>Mode ini Hanya berlaku di PC</span>
              </label>
            </section>
        
            <!-- Gerak -->
            <section class="a11y-group">
              <h3 class="a11y-title">Gerak</h3>
              <label class="a11y-toggle">
                <input type="checkbox" data-a11y="reduceMotion" />
                <span>Kurangi animasi</span>
              </label>
            </section>
        
            <!-- Bacaan suara (eksperimental) -->
            <section class="a11y-group" data-tts-panel>
              <h3 class="a11y-title">
                Bacaan suara <span class="a11y-badge">Eksperimental</span>
              </h3>
              <p class="a11y-note">
                Memakai suara bawaan perangkat. Dukungan bahasa dan kualitas suara bisa berbeda
                di setiap browser dan perangkat.
              </p>
        
              <div class="a11y-segment a11y-tts">
                <button type="button" data-tts="play">Putar</button>
                <button type="button" data-tts="pause" disabled>Jeda</button>
                <button type="button" data-tts="resume" disabled>Lanjut</button>
                <button type="button" data-tts="stop" disabled>Berhenti</button>
              </div>
        
              <label class="a11y-slider">
                <span>Kecepatan <output data-tts-rate-value>1.0</output>×</span>
                <input type="range" value="1" data-tts-rate />
              </label>
        
              <label class="a11y-slider">
                <span>Suara</span>
                <select class="a11y-select" data-tts-voice>
                  <option value="">Otomatis (sesuai bahasa)</option>
                </select>
              </label>
        
              <label class="a11y-toggle">
                <input type="checkbox" data-tts-title-only />
                <span>Bacakan judul saja</span>
              </label>
        
              <p class="a11y-status" data-tts-status aria-live="polite"></p>
            </section>
        
            <button type="button" class="a11y-reset" data-a11y-reset>Reset konfigurasi</button>
          </div>
        </dialog>

        <!-- Pagination -->
        {currentPage && <DocsPagination currentPage={currentPage} prevPage={prevPage} nextPage={nextPage} client:load />}
      </main>

      <!-- RIGHT SIDEBAR (Table of Contents, desktop xl+) -->
      {tocHeadings.length > 0 && (
        <aside class="hidden xl:flex flex-col w-52 shrink-0 border-l-2
                      border-orb-dark dark:border-orb-tan
                      sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto hide-scrollbar">
          <div class="p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 bg-green-400 shrink-0 inline-block"></span>
              <span class="text-xs font-bold uppercase tracking-widest
                           text-orb-dark dark:text-orb-tan">
                In This Guide
              </span>
            </div>
            <nav class="space-y-1">
              {tocHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  data-toc-link
                  data-slug={h.slug}
                  class={[
                    "toc-link block transition-colors py-1 border-l-2 border-transparent",
                    "text-orb-dark/55 hover:text-orb-dark active:text-orb-dark dark:text-orb-tan/55 dark:hover:text-orb-tan dark:active:text-orb-tan",
                    h.depth === 2 ? "pl-2 text-sm" : "pl-5 text-xs",
                  ].join(" ")}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}

    </div>

    <!-- Definisi filter warna (SVG). Dipanggil dari CSS lewat url(#...). -->
    <!-- matriks di atas adalah simulasi cara penglihatan dengan defisiensi warna, bukan koreksi -->
    <svg class="a11y-svg-defs" aria-hidden="true" focusable="false">
      <defs>
        <filter id="orb-cb-protanopia" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.152286 1.052583 -0.204868 0 0  0.114503 0.786281 0.099216 0 0  -0.003882 -0.048116 1.051998 0 0  0 0 0 1 0" />
        </filter>
        <filter id="orb-cb-deuteranopia" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.367322 0.860646 -0.227968 0 0  0.280085 0.672501 0.047413 0 0  -0.011820 0.042940 0.968881 0 0  0 0 0 1 0" />
        </filter>
        <filter id="orb-cb-tritanopia" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="1.255528 -0.076749 -0.178779 0 0  -0.078411 0.930809 0.147602 0 0  0.004733 0.691367 0.303900 0 0  0 0 0 1 0" />
        </filter>
      </defs>
    </svg>
    
    <!-- Hide scrollbar milik sidebar: hardcoded CSS, tidak bergantung pada plugin Tailwind -->
    <style is:global>
      .hide-scrollbar {
        -ms-overflow-style: none;   /* IE & Edge lama */
        scrollbar-width: none;      /* Firefox */
      }
      .hide-scrollbar::-webkit-scrollbar {
        display: none;              /* Chrome, Safari, Edge baru */
        width: 0;
        height: 0;
      }

      /* Heading tidak tertutup navbar saat dituju lewat anchor */
      .prose :is(h1, h2, h3, h4, h5, h6)[id] {
        scroll-margin-top: 4.5rem;
      }
    </style>

    <!-- Execute rendering KaTeX & Mermaid -->
    <script src="/js/blocks.js" data-astro-rerun></script>

    <!-- Dock & dialog: buka, tutup, dan klik backdrop -->
    <script>
      function setupDock() {
        const dock = document.querySelector<HTMLElement>("[data-dock]");
        if (!dock || dock.dataset.ready === "true") return;
        dock.dataset.ready = "true";
    
        const dialogs = new Map<string, HTMLDialogElement>();
        document.querySelectorAll<HTMLDialogElement>("[data-dialog]").forEach((d) =>
          dialogs.set(d.dataset.dialog!, d)
        );
    
        // Tombol pembuka di dock mobile
        dock.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const dlg = dialogs.get(btn.dataset.open!);
            if (dlg && !dlg.open) dlg.showModal();
          });
        });
    
        dialogs.forEach((dlg) => {
          // Tombol ✕
          dlg.querySelectorAll("[data-close]").forEach((b) =>
            b.addEventListener("click", () => dlg.close())
          );
          // Klik backdrop: target adalah dialog itu sendiri, bukan isinya
          dlg.addEventListener("click", (e) => {
            if (e.target === dlg) dlg.close();
          });
          // Link TOC menutup popup setelah dipilih
          dlg.querySelectorAll<HTMLAnchorElement>("[data-close-on-click]").forEach((a) =>
            a.addEventListener("click", () => dlg.close())
          );
        });
      }
    
      setupDock();
      document.addEventListener("astro:page-load", setupDock);
    </script>
    
    <!-- TOC scroll-spy: highlight heading yang sedang tampil di viewport -->
    <script>
      type A11yState = {
        textSize: "normal" | "large";
        spacing: "normal" | "wide";
        contrast: "normal" | "high";
        colorFilter: "none" | "protanopia" | "deuteranopia" | "tritanopia";
        monochrome: boolean;
        dyslexic: boolean;
        reduceMotion: boolean;
        readFocus: boolean;
      };
    
      const DEFAULTS: A11yState = {
        textSize: "normal",
        spacing: "normal",
        contrast: "normal",
        colorFilter: "none",
        monochrome: false,
        dyslexic: false,
        reduceMotion: false,
        readFocus: false,
      };
    
      const KEY = "orb-a11y";
    
      function load(): A11yState {
        try {
          return { ...DEFAULTS, ...JSON.parse(localStorage.getItem(KEY) ?? "{}") };
        } catch {
          return { ...DEFAULTS };
        }
      }
    
      function save(state: A11yState) {
        try {
          localStorage.setItem(KEY, JSON.stringify(state));
        } catch {}
      }
    
      // Nilai default menghapus atribut data-* dari <html>
      function apply(state: A11yState) {
        const root = document.documentElement;
        const set = (name: string, on: boolean, value: string) => {
          if (on) root.dataset[name] = value;
          else delete root.dataset[name];
        };
        set("textSize", state.textSize !== "normal", state.textSize);
        set("spacing", state.spacing !== "normal", state.spacing);
        set("contrast", state.contrast !== "normal", state.contrast);
        set("colorFilter", state.colorFilter !== "none", state.colorFilter);
        set("monochrome", state.monochrome, "true");
        set("dyslexic", state.dyslexic, "true");
        set("reduceMotion", state.reduceMotion, "true");
        set("readFocus", state.readFocus, "true");
      }
    
      function syncControls(state: A11yState) {
        document.querySelectorAll<HTMLButtonElement>('[role="radio"][data-a11y]').forEach((btn) => {
          const key = btn.dataset.a11y as keyof A11yState;
          btn.setAttribute("aria-checked", String(state[key] === btn.dataset.value));
        });
        document.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-a11y]').forEach((input) => {
          const key = input.dataset.a11y as keyof A11yState;
          input.checked = Boolean(state[key]);
        });
      }
    
      function setupA11y() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-dialog="a11y"]');
        if (!dialog || dialog.dataset.ready === "true") {
          // Terapkan state di setiap navigasi, walau dialog sudah diinisialisasi
          apply(load());
          return;
        }
        dialog.dataset.ready = "true";
    
        let state = load();
        apply(state);
        syncControls(state);
    
        const update = (next: A11yState) => {
          state = next;
          save(state);
          apply(state);
          syncControls(state);
        };
    
        dialog.querySelectorAll<HTMLButtonElement>('[role="radio"][data-a11y]').forEach((btn) => {
          btn.addEventListener("click", () => {
            const key = btn.dataset.a11y as keyof A11yState;
            update({ ...state, [key]: btn.dataset.value });
          });
        });
    
        dialog.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-a11y]').forEach((input) => {
          input.addEventListener("change", () => {
            const key = input.dataset.a11y as keyof A11yState;
            update({ ...state, [key]: input.checked });
          });
        });
    
        dialog.querySelector("[data-a11y-reset]")?.addEventListener("click", () => {
          update({ ...DEFAULTS });
        });
      }
    
      setupA11y();
      document.addEventListener("astro:page-load", setupA11y);
    </script>

    <!-- Accesibility Text to Speech Button Experimental -->
    <script>
      import { initTts } from "../scripts/tts";
    
      initTts();
      document.addEventListener("astro:page-load", () => initTts());
    </script>
  </body>
</html>
