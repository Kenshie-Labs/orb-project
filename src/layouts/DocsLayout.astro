---
import { getCollection, type CollectionEntry } from "astro:content";
import "../styles/global.css";
import Navbar from "../components/Navbar.svelte";
import DocsPagination from "../components/DocsPagination.svelte";
import ThemeInit from "../components/ThemeInit.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  category: string;
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
  excerpt?: string;
}

const { title, category, currentId, headings = [], excerpt } = Astro.props;

// Fetch sidebar entries for this category
const allEntries = await getCollection("content");
const categoryEntries = allEntries
  .filter((e) => e.id.split("/")[0] === category)
  .sort((a, b) => a.id.localeCompare(b.id));

// Group by subcategory (parts[1] if depth >= 3, else "_root")
const grouped: Record<string, CollectionEntry<"content">[]> = {};
for (const entry of categoryEntries) {
  const parts = entry.id.split("/");
  const subcat = parts.length >= 3 ? parts[1] : "_root";
  if (!grouped[subcat]) grouped[subcat] = [];
  grouped[subcat].push(entry);
}

// Build intermediate breadcrumb segments from currentId
// e.g. "academics/informatika/pengantar" → subcatParts = ["informatika"]
let breadcrumbMiddle: { label: string; href: string }[] = [];
if (currentId) {
  const parts = currentId.split("/");
  const subcatParts = parts.slice(1, -1);
  breadcrumbMiddle = subcatParts.map((seg, i) => ({
    label: seg.replace(/-/g, " "),
    href: `/notes/${[parts[0], ...subcatParts.slice(0, i + 1)].join("/")}`,
  }));
}

// Determine previous and next pages for pagination
let currentPage = null;
let prevPage = null;
let nextPage = null;

if (currentId) {
  const currentIndex = categoryEntries.findIndex(entry => entry.id === currentId);
  if (currentIndex !== -1) {
    const currentEntry = categoryEntries[currentIndex];
    currentPage = {
      title: currentEntry.data.title,
      url: `/notes/${currentEntry.id}`
    };

    if (currentIndex > 0) {
      const prevEntry = categoryEntries[currentIndex - 1];
      prevPage = {
        title: prevEntry.data.title,
        url: `/notes/${prevEntry.id}`
      };
    }

    if (currentIndex < categoryEntries.length - 1) {
      const nextEntry = categoryEntries[currentIndex + 1];
      nextPage = {
        title: nextEntry.data.title,
        url: `/notes/${nextEntry.id}`
      };
    }
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="viewport" content="width=device-width" />
    <title>{title} — Orb</title>
    <!-- pwa -->
    <script src="../pwa.ts"></script>
    <!-- FOUC prevention: apply dark class sebelum paint -->
    <ThemeInit />
    <!-- Client-side navigation antar halaman (eliminasi full page reload) -->
    <ClientRouter />
  </head>
  <body class="min-h-screen">

    <!-- Navbar: persisted across navigations agar tidak re-hydrate setiap pindah halaman -->
    <Navbar client:idle transition:persist="navbar" />

    <!-- 3-column docs body -->
    <div class="max-w-screen-xl mx-auto flex min-h-[calc(100vh-3.5rem)]">

      <!-- LEFT SIDEBAR -->
      <aside class="hidden lg:flex flex-col w-64 shrink-0 border-r-2
                    border-orb-dark dark:border-orb-tan
                    sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto">
        <div class="p-5">

          <!-- Back link -->
          <a
            href="/notes"
            class="flex items-center gap-1 text-xs mb-5 uppercase tracking-widest
                   text-orb-dark/50 hover:text-orb-dark active:text-orb-dark
                   dark:text-orb-tan/50 dark:hover:text-orb-tan dark:active:text-orb-tan"
          >
            ← All Notes
          </a>

          <p class="text-xs font-bold uppercase tracking-widest mb-3
                    text-orb-dark/40 dark:text-orb-tan/40">
            Browse {category.replace(/-/g, " ")}
          </p>

          <!-- Root-level files (no subcategory) -->
          {grouped["_root"]?.map((entry) => {
            const isActive = entry.id === currentId;
            return (
              <a
                href={`/notes/${entry.id}`}
                class:list={[
                  "block px-3 py-2 text-sm transition-colors mb-1 border-l-2",
                  isActive
                    ? "border-orange-400 bg-orb-dark text-orb-tan dark:bg-orb-tan dark:text-orb-dark font-semibold"
                    : "border-transparent text-orb-dark dark:text-orb-tan hover:border-orb-dark active:border-orb-dark dark:hover:border-orb-tan dark:active:border-orb-tan hover:bg-orb-dark/5 active:bg-orb-dark/5 dark:hover:bg-orb-tan/5 dark:active:bg-orb-tan/5",
                ]}
              >
                {entry.data.title}
              </a>
            );
          })}

          <!-- Subcategory groups -->
          {Object.entries(grouped)
            .filter(([k]) => k !== "_root")
            .map(([subcat, entries]) => (
              <div class="mt-5">
                <a
                  href={`/notes/${category}/${subcat}`}
                  class="flex items-center gap-2 mb-2 px-1 group"
                >
                  <span class="w-2 h-2 bg-orange-400 shrink-0 inline-block"></span>
                  <span class="text-xs font-bold uppercase tracking-widest transition-colors
                               text-orb-dark/60 group-hover:text-orb-dark group-active:text-orb-dark
                               dark:text-orb-tan/60 dark:group-hover:text-orb-tan dark:group-active:text-orb-tan">
                    {subcat.replace(/-/g, " ")}
                  </span>
                </a>
                {entries.map((entry) => {
                  const isActive = entry.id === currentId;
                  return (
                    <a
                      href={`/notes/${entry.id}`}
                      class:list={[
                        "block px-3 py-2 text-sm transition-colors mb-1 border-l-2",
                        isActive
                          ? "border-orange-400 bg-orb-dark text-orb-tan dark:bg-orb-tan dark:text-orb-dark font-semibold"
                          : "border-transparent text-orb-dark dark:text-orb-tan hover:border-orb-dark active:border-orb-dark dark:hover:border-orb-tan dark:active:border-orb-tan hover:bg-orb-dark/5 active:bg-orb-dark/5 dark:hover:bg-orb-tan/5 dark:active:bg-orb-tan/5",
                      ]}
                    >
                      {entry.data.title}
                    </a>
                  );
                })}
              </div>
            ))}
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="flex-1 min-w-0 px-8 py-10 max-w-3xl">

        <!-- Breadcrumb -->
        <nav class="flex flex-wrap items-center gap-1.5 text-sm mb-6
                    text-orb-dark/50 dark:text-orb-tan/50">
          <a href="/" class="hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">Home</a>
          <span>/</span>
          <a href="/notes" class="hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">Notes</a>
          <span>/</span>
          <a href={`/notes/${category}`}
             class="capitalize hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">
            {category.replace(/-/g, " ")}
          </a>
          {breadcrumbMiddle.map((seg) => (
            <>
              <span>/</span>
              <a href={seg.href} class="capitalize hover:text-orb-dark active:text-orb-dark dark:hover:text-orb-tan dark:active:text-orb-tan">
                {seg.label}
              </a>
            </>
          ))}
          {currentId && (
            <>
              <span>/</span>
              <span class="font-medium text-orb-dark dark:text-orb-tan">{title}</span>
            </>
          )}
        </nav>

        <!-- Category chip -->
        <span class="inline-block px-3 py-1 text-xs font-bold uppercase mb-5 tracking-widest
                     border-2 border-orb-dark bg-orange-400 dark:border-orb-tan">
          {category.replace(/-/g, " ")}
        </span>

        <!-- Page title -->
        <h1 class="text-5xl font-petrona font-light leading-tight mb-3
                   text-orb-dark dark:text-orb-tan">
          {title}
        </h1>

        {excerpt && (
          <p class="text-lg mb-2 font-light text-orb-dark/60 dark:text-orb-tan/60">
            {excerpt}
          </p>
        )}

        <!-- TOC Mobile (Hanya muncul di mobile/tablet) -->
        {headings.filter((h) => h.depth <= 3).length > 0 && (
          <details class="xl:hidden mb-8 border-2 border-orb-dark dark:border-orb-tan shadow-brutal dark:shadow-brutal-onDarkMode bg-white dark:bg-orb-dark/50">
            <summary class="p-4 cursor-pointer font-bold uppercase tracking-widest text-sm flex items-center gap-2">
              <span class="w-2 h-2 bg-green-400"></span>
              In This Guide
            </summary>
            <nav class="p-4 border-t-2 border-orb-dark dark:border-orb-tan space-y-2">
              {headings.filter((h) => h.depth <= 3).map((h) => (
                <a
                  href={`#${h.slug}`}
                  class:list={[
                    "block text-sm hover:text-orange-500 active:text-orange-500 transition-colors font-source-sans",
                    h.depth === 2 ? "pl-2 font-bold" : "pl-6 text-xs",
                  ]}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <!-- Markdown content -->
        <div class="prose prose-neutral prose-brutal dark:prose-dark max-w-none
                    mt-8 pt-8 border-t-2 border-orb-dark/20 dark:border-orb-tan/20">
          <slot />
        </div>

        <!-- Pagination -->
        {currentPage && <DocsPagination currentPage={currentPage} prevPage={prevPage} nextPage={nextPage} client:load />}
      </main>

      <!-- RIGHT SIDEBAR (Table of Contents) -->
      {headings.filter((h) => h.depth <= 3).length > 0 && (
        <aside class="hidden xl:flex flex-col w-52 shrink-0 border-l-2
                      border-orb-dark dark:border-orb-tan
                      sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto">
          <div class="p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 bg-green-400 shrink-0 inline-block"></span>
              <span class="text-xs font-bold uppercase tracking-widest
                           text-orb-dark dark:text-orb-tan">
                In This Guide
              </span>
            </div>
            <nav class="space-y-1">
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      "block transition-colors py-1 border-l-2 border-transparent hover:border-orange-400 active:border-orange-400",
                      "text-orb-dark/55 hover:text-orb-dark active:text-orb-dark dark:text-orb-tan/55 dark:hover:text-orb-tan dark:active:text-orb-tan",
                      h.depth === 2 ? "pl-2 text-sm" : "pl-5 text-xs",
                    ]}
                  >
                    {h.text}
                  </a>
                ))}
            </nav>
          </div>
        </aside>
      )}

    </div>

    <!-- Manual setup DOM untuk tombol copy pada code blocks -->
    <script>
      function setupCodeBlocks() {
        const codeBlocks = document.querySelectorAll('pre');
        
        codeBlocks.forEach((block) => {
          
          // Mencegah duplikasi
          if (block.parentElement?.classList.contains('code-wrapper')) return;
    
          // 1. Deteksi Bahasa (Astro/Shiki biasanya memberi class "language-xxx")
          const codeEl = block.querySelector('code');
          // Cek class di <pre> ATAU di <code>
          const combinedClasses = [...block.classList, ...Array.from(codeEl?.classList || [])];
          const langClass = combinedClasses.find(c => c.startsWith('language-') || c.startsWith('lang-'));
          // Cek attribute data-language yang biasanya diset Shiki
          const lang = block.getAttribute('data-language') || codeEl?.getAttribute('data-language') || 'CODE';
    
          // 2. Buat Wrapper
          const wrapper = document.createElement('div');
          wrapper.className = 'code-wrapper my-6 border rounded overflow-hidden border-orb-dark dark:border-orb-tan shadow-brutal dark:shadow-brutal-onDarkMode/70';
          
          // 3. Buat Header
          const header = document.createElement('div');
          header.className = 'flex justify-between items-center px-4 py-2 border-b-2 border-orb-dark dark:border-orb-tan bg-orb-dark/5 dark:bg-orb-tan/5';
          header.innerHTML = `
            <span class="text-[10px] font-bold uppercase tracking-widest text-orb-dark dark:text-orb-tan">${lang}</span>
            <button class="copy-btn text-orb-dark dark:text-orb-tan active:text-orange-500 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          `;
    
          // 4. Logika Copy
          const button = header.querySelector('.copy-btn');
          button?.addEventListener('click', async () => {
            const code = codeEl?.innerText || '';
            await navigator.clipboard.writeText(code);
            button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
            setTimeout(() => {
              button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
            }, 2000);
          });
    
          // 5. Susun DOM: Wrapper -> Header -> Pre
          block.parentNode?.insertBefore(wrapper, block);
          wrapper.appendChild(header);
          wrapper.appendChild(block);
          
          // Bersihkan style 'pre' bawaan agar tidak konflik
          block.className = 'p-4 overflow-x-auto';
        });
      }
    
      setupCodeBlocks();
      document.addEventListener('astro:page-load', setupCodeBlocks);
    </script>

  </body>
</html>
