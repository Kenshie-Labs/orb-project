---
import { getCollection, type CollectionEntry } from "astro:content";
import "../styles/global.css";

interface Props {
  title: string;
  category: string;
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
  excerpt?: string;
}

const { title, category, currentId, headings = [], excerpt } = Astro.props;

// Fetch sidebar entries for this category
const allEntries = await getCollection("content");
const categoryEntries = allEntries
  .filter((e) => e.id.split("/")[0] === category)
  .sort((a, b) => a.id.localeCompare(b.id));

// Group by subcategory (parts[1] if depth >= 3, else "_root")
const grouped: Record<string, CollectionEntry<"content">[]> = {};
for (const entry of categoryEntries) {
  const parts = entry.id.split("/");
  const subcat = parts.length >= 3 ? parts[1] : "_root";
  if (!grouped[subcat]) grouped[subcat] = [];
  grouped[subcat].push(entry);
}

// Build intermediate breadcrumb segments from currentId
// e.g. "academics/informatika/pengantar" → subcatParts = ["informatika"]
let breadcrumbMiddle: { label: string; href: string }[] = [];
if (currentId) {
  const parts = currentId.split("/");
  const subcatParts = parts.slice(1, -1);
  breadcrumbMiddle = subcatParts.map((seg, i) => ({
    label: seg.replace(/-/g, " "),
    href: `/notes/${[parts[0], ...subcatParts.slice(0, i + 1)].join("/")}`,
  }));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — Orb</title>
  </head>
  <body class="min-h-screen">

    <!-- Header -->
    <header class="sticky top-0 z-50 border-b-2 border-orb-dark bg-orb-tan">
      <div class="max-w-screen-xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-petrona font-bold text-lg tracking-wide">
          <img src="/favicon.svg" alt="Orb logo" class="w-7 h-7" />
          ORB Knownrie
        </a>
        <nav class="flex gap-6 text-sm">
          <a href="/notes" class="hover:underline">Notes</a>
          <a href="/" class="hover:underline">About</a>
        </nav>
      </div>
    </header>

    <!-- 3-column docs body -->
    <div class="max-w-screen-xl mx-auto flex min-h-[calc(100vh-3.5rem)]">

      <!-- LEFT SIDEBAR -->
      <aside class="hidden lg:flex flex-col w-64 shrink-0 border-r-2 border-orb-dark sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto">
        <div class="p-5">

          <!-- Back link -->
          <a
            href="/notes"
            class="flex items-center gap-1 text-xs text-orb-dark/50 hover:text-orb-dark mb-5 uppercase tracking-widest"
          >
            ← All Notes
          </a>

          <p class="text-xs font-bold uppercase tracking-widest text-orb-dark/40 mb-3">
            Browse {category.replace(/-/g, " ")}
          </p>

          <!-- Root-level files (no subcategory) -->
          {grouped["_root"]?.map((entry) => {
            const isActive = entry.id === currentId;
            return (
              <a
                href={`/notes/${entry.id}`}
                class:list={[
                  "block px-3 py-2 text-sm transition-colors mb-1 border-l-2",
                  isActive
                    ? "border-orange-400 bg-orb-dark text-orb-tan font-semibold"
                    : "border-transparent hover:border-orb-dark hover:bg-orb-dark/5",
                ]}
              >
                {entry.data.title}
              </a>
            );
          })}

          <!-- Subcategory groups -->
          {Object.entries(grouped)
            .filter(([k]) => k !== "_root")
            .map(([subcat, entries]) => (
              <div class="mt-5">
                <a
                  href={`/notes/${category}/${subcat}`}
                  class="flex items-center gap-2 mb-2 px-1 group"
                >
                  <span class="w-2 h-2 bg-blue-400 shrink-0 inline-block"></span>
                  <span class="text-xs font-bold uppercase tracking-widest text-orb-dark/60 group-hover:text-orb-dark transition-colors">
                    {subcat.replace(/-/g, " ")}
                  </span>
                </a>
                {entries.map((entry) => {
                  const isActive = entry.id === currentId;
                  return (
                    <a
                      href={`/notes/${entry.id}`}
                      class:list={[
                        "block px-3 py-2 text-sm transition-colors mb-1 border-l-2",
                        isActive
                          ? "border-orange-400 bg-orb-dark text-orb-tan font-semibold"
                          : "border-transparent hover:border-orb-dark hover:bg-orb-dark/5",
                      ]}
                    >
                      {entry.data.title}
                    </a>
                  );
                })}
              </div>
            ))}
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="flex-1 min-w-0 px-8 py-10 max-w-3xl">

        <!-- Breadcrumb -->
        <nav class="flex flex-wrap items-center gap-1.5 text-sm text-orb-dark/50 mb-6">
          <a href="/" class="hover:text-orb-dark">Home</a>
          <span>/</span>
          <a href="/notes" class="hover:text-orb-dark">Notes</a>
          <span>/</span>
          <a href={`/notes/${category}`} class="capitalize hover:text-orb-dark">
            {category.replace(/-/g, " ")}
          </a>
          {breadcrumbMiddle.map((seg) => (
            <>
              <span>/</span>
              <a href={seg.href} class="capitalize hover:text-orb-dark">
                {seg.label}
              </a>
            </>
          ))}
          {currentId && (
            <>
              <span>/</span>
              <span class="text-orb-dark font-medium">{title}</span>
            </>
          )}
        </nav>

        <!-- Category chip -->
        <span class="inline-block px-3 py-1 text-xs font-bold uppercase border-2 border-orb-dark bg-orange-400 mb-5 tracking-widest">
          {category.replace(/-/g, " ")}
        </span>

        <!-- Page title -->
        <h1 class="text-5xl font-petrona font-light leading-tight mb-3">{title}</h1>

        {excerpt && (
          <p class="text-orb-dark/60 text-lg mb-2 font-light">{excerpt}</p>
        )}

        <!-- Markdown content -->
        <div class="prose prose-neutral prose-brutal max-w-none mt-8 pt-8 border-t-2 border-orb-dark/20">
          <slot />
        </div>
      </main>

      <!-- RIGHT SIDEBAR (Table of Contents) -->
      {headings.filter((h) => h.depth <= 3).length > 0 && (
        <aside class="hidden xl:flex flex-col w-52 shrink-0 border-l-2 border-orb-dark sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto">
          <div class="p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 bg-orange-400 shrink-0 inline-block"></span>
              <span class="text-xs font-bold uppercase tracking-widest">In This Guide</span>
            </div>
            <nav class="space-y-1">
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      "block text-orb-dark/55 hover:text-orb-dark transition-colors py-1 border-l-2 border-transparent hover:border-orange-400",
                      h.depth === 2 ? "pl-2 text-sm" : "pl-5 text-xs",
                    ]}
                  >
                    {h.text}
                  </a>
                ))}
            </nav>
          </div>
        </aside>
      )}

    </div>
  </body>
</html>
